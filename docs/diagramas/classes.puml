@startuml classes
title Diagrama de Classes - Controle de uso de infraestrutura computacional

skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

' ======================= Domínio: entidades e VOs =======================
package "reservas.dominio" {

  enum EstadoReserva {
    PENDENTE
    APROVADA
    ATIVA
    ENCERRADA
    REJEITADA
    CANCELADA
  }

  class Periodo <<value object>> {
    +inicio : Instant
    +fim : Instant
    +sobrepoe(outro : Periodo) : boolean
    +duracao() : Duration
  }

  class Reserva {
    +id
    +estado : EstadoReserva
    +quantidade : int
    +solicitanteId
    +aprovadorId [0..1]
    +dataDecisao : Instant [0..1]
    +acessoLiberado : boolean
    +aprovar(aprovadorId)
    +rejeitar(aprovadorId)
    +ativar()
    +encerrar()
    +cancelar()
  }

  abstract class EventoReserva <<evento de domínio>> {
    +reservaId
    +solicitanteId
  }
  class ReservaPendente {
    +responsavelId
  }
  class ReservaAprovada {
    +aprovadorId [0..1]
  }
  class ReservaRejeitada {
    +aprovadorId
  }
  class ReservaCancelada
  class ReservaAtivada
  class ReservaEncerrada

  ReservaPendente --|> EventoReserva
  ReservaAprovada --|> EventoReserva
  ReservaRejeitada --|> EventoReserva
  ReservaCancelada --|> EventoReserva
  ReservaAtivada --|> EventoReserva
  ReservaEncerrada --|> EventoReserva

  class AgendaRecurso {
    +verificarDisponibilidade(periodo : Periodo, quantidade : int)
    +criarReserva(...) : Reserva
  }

  Reserva *-- Periodo
  Reserva --> EstadoReserva
  AgendaRecurso ..> Reserva : cria
  AgendaRecurso --> .catalogo.Recurso
}

' ======================= Catálogo =======================
package "catalogo" {
  class Recurso {
    +id
    +tipo : TipoRecurso
    +capacidade : int
    +comporta(quantidade : int) : boolean
  }
  enum TipoRecurso {
    GPU
    SERVIDOR
    STORAGE
  }
  interface CatalogoRecursos {
    +buscar(id) : Recurso
    +obterParaAtualizacao(id) : Recurso
  }
  Recurso --> TipoRecurso
  CatalogoRecursos ..> Recurso
}

' ======================= Quotas e políticas =======================
package "quotas" {
  class Projeto {
    +id
    +responsavelId
  }
  class Quota {
    +modo : ModoQuota
    +limite
    +comporta(pedido) : boolean
    +consumir(pedido)
    +devolver(pedido)
  }
  enum ModoQuota {
    ACUMULADA_MENSAL
    CAPACIDADE_SIMULTANEA
  }
  class Consumo {
    +inicio : Instant
    +fim : Instant
    +quantidade : int
  }
  class Pedido <<value object>> {
    +projetoId
    +tipoRecurso
    +quantidade : int
    +inicio : Instant
    +fim : Instant
    +papelSolicitante
  }
  interface ControleQuotas {
    +verificarQuota(pedido)
    +avaliarPoliticas(pedido) : Decisao
    +consumir(pedido)
    +devolver(pedido)
    +responsavelDe(projeto) : responsavelId
    +obterParaAtualizacao(projeto, pedido) : Quota
  }
  interface PoliticaAutorizacao {
    +avaliar(pedido) : Decisao
  }
  enum Decisao {
    AUTO_APROVAR
    EXIGIR_APROVACAO
    NEGAR
  }
  class PoliticaLimiteGpuDuracao
  class PoliticaGpuApenasDoutorandos

  Projeto *-- Quota
  Quota --> ModoQuota
  Quota *-- "*" Consumo
  Quota ..> Pedido
  ControleQuotas ..> Pedido
  PoliticaAutorizacao ..> Pedido
  PoliticaAutorizacao ..> Decisao
  PoliticaLimiteGpuDuracao ..|> PoliticaAutorizacao
  PoliticaGpuApenasDoutorandos ..|> PoliticaAutorizacao
  ControleQuotas ..> Quota
  ControleQuotas ..> PoliticaAutorizacao
}

' ======================= Identidade =======================
package "identidade" {
  class Usuario {
    +id
    +papel : Papel
    +contato
  }
  enum Papel {
    ALUNO
    DOUTORANDO
    ORIENTADOR
    ADMINISTRADOR
  }
  interface ServicoAutenticacao {
    +autenticar(credencial) : Usuario
  }
  interface DiretorioUsuarios {
    +buscar(id) : Usuario
  }
  class ServicoAutenticacaoFake
  Usuario --> Papel
  ServicoAutenticacaoFake ..|> ServicoAutenticacao
}

' ======================= Aplicação: caso de uso e portas =======================
package "reservas.aplicacao" {
  class SolicitarReservaUseCase {
    +executar(comando)
  }
  interface RepositorioReservas {
    +salvar(reserva)
    +buscarPorId(id) : Reserva
    +listarPorUsuario(usuario)
    +listarPorRecurso(recurso, periodo)
    +listarParaAtivar(agora)
    +listarParaEncerrar(agora)
  }
  interface Provisionador {
    +liberarAcesso(reserva)
    +revogarAcesso(reserva)
  }
  interface PublicadorEventos {
    +publicar(evento)
  }
  interface UnidadeDeTrabalho {
    +executar(operacao)
  }

  SolicitarReservaUseCase ..> UnidadeDeTrabalho
  SolicitarReservaUseCase ..> CatalogoRecursos
  SolicitarReservaUseCase ..> ControleQuotas
  SolicitarReservaUseCase ..> AgendaRecurso
  SolicitarReservaUseCase ..> RepositorioReservas
  SolicitarReservaUseCase ..> PublicadorEventos
  PublicadorEventos ..> EventoReserva
}

' ======================= Notificações =======================
package "notificacoes" {
  interface Notificador {
    +notificar(destinatario : Usuario, mensagem)
  }
  class EmailNotificador
  class NotificadorFake
  class TratadorDeEventos {
    +tratar(evento)
  }
  EmailNotificador ..|> Notificador
  NotificadorFake ..|> Notificador
  TratadorDeEventos ..> Notificador
  TratadorDeEventos ..> DiretorioUsuarios
  TratadorDeEventos ..> EventoReserva
}

' ======================= Provisionamento =======================
package "provisionamento" {
  class SlurmProvisionador
  class ProvisionadorFake
  SlurmProvisionador ..|> Provisionador
  ProvisionadorFake ..|> Provisionador
}

Reserva --> Projeto
Reserva --> catalogo.Recurso

@enduml
